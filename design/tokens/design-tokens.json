  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "2xl": "20px",
    "full": "9999px",
    "window": "10px",
    "dock": "16px",
    "menu": "8px"
  },
  "shadows": {
    "light": {
      "sm":     "0 1px 2px rgba(0, 0, 0, 0.06)",
      "md":     "0 4px 12px rgba(0, 0, 0, 0.08)",
      "lg":     "0 8px 24px rgba(0, 0, 0, 0.12)",
      "xl":     "0 16px 48px rgba(0, 0, 0, 0.16)",
      "dock":   "0 8px 32px rgba(0, 0, 0, 0.18)",
      "window": "0 12px 40px rgba(0, 0, 0, 0.15)",
      "menu":   "0 6px 20px rgba(0, 0, 0, 0.12)"
    },
    "dark": {
      "sm":     "0 1px 2px rgba(0, 0, 0, 0.20)",
      "md":     "0 4px 12px rgba(0, 0, 0, 0.30)",
      "lg":     "0 8px 24px rgba(0, 0, 0, 0.40)",
      "xl":     "0 16px 48px rgba(0, 0, 0, 0.50)",
      "dock":   "0 8px 32px rgba(0, 0, 0, 0.50)",
      "window": "0 12px 40px rgba(0, 0, 0, 0.45)",
      "menu":   "0 6px 20px rgba(0, 0, 0, 0.40)"
    }
  },
  "motion": {
    "duration": {
      "instant": "0ms",
      "fast": "100ms",
      "normal": "200ms",
      "slow": "350ms",
      "slower": "500ms",
      "enter": "250ms",
      "exit": "200ms"
    },
    "easing": {
      "default": "cubic-bezier(0.25, 0.1, 0.25, 1.0)",
      "in": "cubic-bezier(0.42, 0, 1.0, 1.0)",
      "out": "cubic-bezier(0, 0, 0.58, 1.0)",
      "inOut": "cubic-bezier(0.42, 0, 0.58, 1.0)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1.0)",
      "bounce": "cubic-bezier(0.68, -0.6, 0.32, 1.6)"
    }
  },
  "blur": {
    "panel": "20px",
    "dock": "24px",
    "menu": "16px",
    "overlay": "30px",
    "login": "40px"
  },
  "iconSize": {
    "xs": "12px",
