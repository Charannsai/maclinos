      "height": "28px"
    },
    "dock": {
      "height": "68px",
      "iconSize": "48px",
      "iconSizeHover": "64px",
      "runningIndicator": "4px"
    },
    "titleBar": {
      "height": "28px",
      "buttonSize": "12px",
      "buttonSpacing": "8px",
      "buttonOffset": "8px"
    },
    "notification": {
      "width": "340px"
    }
  }
