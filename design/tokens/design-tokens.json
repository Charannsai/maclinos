{
  "name": "MaclinOS Design Tokens",
  "version": "0.1.0",
  "colors": {
    "accent": {
      "primary":       { "light": "#0066FF", "dark": "#3399FF" },
      "primaryHover":  { "light": "#005CE6", "dark": "#4DA6FF" },
      "primaryPress":  { "light": "#0052CC", "dark": "#66B3FF" },
      "primaryMuted":  { "light": "rgba(0, 102, 255, 0.15)", "dark": "rgba(51, 153, 255, 0.20)" }
    },
    "background": {
      "primary":    { "light": "#FFFFFF", "dark": "#1C1C1E" },
