      "strong":   { "light": "rgba(0, 0, 0, 0.20)", "dark": "rgba(255, 255, 255, 0.20)" },
      "focus":    { "light": "#0066FF", "dark": "#3399FF" }
    },
    "status": {
      "success":  { "light": "#30D158", "dark": "#30D158" },
      "warning":  { "light": "#FF9F0A", "dark": "#FFD60A" },
      "error":    { "light": "#FF3B30", "dark": "#FF453A" },
      "info":     { "light": "#0A84FF", "dark": "#0A84FF" }
    },
    "windowButtons": {
      "close":      "#FF5F57",
      "minimize":   "#FEBC2E",
      "maximize":   "#28C840",
      "closeHover": "#FF3B30",
      "minimizeHover": "#E5A100",
      "maximizeHover": "#1AAB29"
    }
  },
  "typography": {
    "fontFamily": {
      "system": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace",
      "display": "'Inter', sans-serif"
    },
    "scale": {
