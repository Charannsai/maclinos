      "dock":     { "light": "rgba(245, 245, 247, 0.75)", "dark": "rgba(58, 58, 60, 0.75)" },
      "menu":     { "light": "rgba(255, 255, 255, 0.90)", "dark": "rgba(44, 44, 46, 0.90)" },
      "overlay":  { "light": "rgba(0, 0, 0, 0.40)", "dark": "rgba(0, 0, 0, 0.60)" }
    },
    "text": {
      "primary":    { "light": "#1D1D1F", "dark": "#F5F5F7" },
